# ========================================================
# PORTAL BERITA - DOCKER ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env.docker atau .env sebelum menjalankan docker compose
# ========================================================

# --- Host Port Mapping ---
HOST_POSTGRES_PORT=5435
HOST_REDIS_PORT=6380
HOST_BACKEND_PORT=5050
HOST_FRONTEND_ADMIN_PORT=5175
HOST_FRONTEND_USER_PORT=5176

# --- Cache Configuration ---
REDIS_URL=redis://redis:6379

# --- Database Configuration ---
POSTGRES_DB=portal_berita
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# --- Backend Application Configuration ---
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_portal_berita_2025
SEQUELIZE_ALTER=false

# Cloudinary (Isi dengan kredensial Cloudinary Anda untuk upload gambar)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# CORS (Izinkan akses dari host frontend)
CORS_ORIGIN=http://localhost:5175,http://localhost:5176

# --- Frontend Build Args ---
VITE_API_URL=http://localhost:5050/api
