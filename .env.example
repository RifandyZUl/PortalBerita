# ==============================================
# Environment Variables Example Configuration
# ==============================================

# Database Configuration (Local PostgreSQL)
DB_NAME=portal_berita
DB_USER=postgres
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Production Database (Railway / Cloud)
DATABASE_URL=postgresql://user:password@host:port/database
RAILWAY_DATABASE_URL=postgresql://user:password@host:port/database

# Server Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Sequelize Migration Settings
SEQUELIZE_ALTER=false
